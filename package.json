{
  "name": "undox",
  "version": "0.1.0",
  "private": true,
  "description": "TrueForge agent that finds data-broker PII leaks and drives opt-outs with human approval",
  "type": "module",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "mcp:undox-tools": "node --env-file=.env --import tsx src/mcp/undox-tools/server.ts",
    "mcp:undox-tools:http": "node --env-file=.env --import tsx src/mcp/undox-tools/http-server.ts",
    "fixtures:serve": "node --env-file=.env --import tsx scripts/serve-fixtures.ts",
    "dashboard:serve": "node --env-file=.env --import tsx scripts/serve-dashboard.ts",
    "sandbox:spokeo-prepare": "node --env-file=.env --import tsx src/sandbox/spokeo-prepare-optout.ts",
    "sandbox:peoplefind-prepare": "node --env-file=.env --import tsx src/sandbox/peoplefind-prepare-optout.ts",
    "sandbox:clearbook-prepare": "node --env-file=.env --import tsx src/sandbox/clearbook-prepare-optout.ts",
    "register:agent": "node --env-file=.env --import tsx src/agents/register-orchestrator.ts",
    "demo:approval-gate": "node --env-file=.env --import tsx scripts/demo-approval-gate.ts",
    "demo:multi-broker": "node --env-file=.env --import tsx scripts/demo-multi-broker.ts",
    "prove:heart": "node --import tsx scripts/prove-heart.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/**/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@truefoundry/trueforge-sdk": "^0.1.3",
    "express": "^5.2.1",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.15.29",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
