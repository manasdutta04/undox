# TrueForge local server (default from `npx @truefoundry/trueforge`)
TRUEFORGE_BASE_URL=http://localhost:8790

# Optional: ID token when OIDC is enabled (omit for local mode — no login)
# TRUEFORGE_TOKEN=

# Local free path (no cloud TPM): Ollama OpenAI-compatible API
#   ollama pull qwen2.5-coder:7b
# If TrueForge runs in WSL, set host to Windows IP (not 127.0.0.1):
#   wsl: ip route show | awk '/default/{print $3}'
# Then: UNDOX_OLLAMA_HOST=172.x.x.1 node --env-file=.env --import tsx scripts/configure-ollama-provider.ts
UNDOX_OLLAMA_HOST=127.0.0.1
# Prefer gemma4-e2b: native tool_calls. qwen2.5-coder:7b only prints JSON text.
UNDOX_MODEL=ollama/gemma4-e2b
UNDOX_REASONING_EFFORT=none
# Cloud free fallback (TPM-limited): groq/qwen3-6-27b or groq/openai-gpt-oss-20b
# UNDOX_MODEL=groq/qwen3-6-27b

# Set to "false" to register the agent without the spokeo skill attached
UNDOX_ATTACH_SKILLS=false

# Must match the connector Name in TrueForge Settings → Connectors
UNDOX_MCP_NAME=undox-tool

# Optional: where Undox MCP persists mock session state
UNDOX_SESSION_STORE=./.undox-session-state.json

# Demo / fixture person used by `npm run demo:approval-gate`
DEMO_FULL_NAME=Alex Rivera
DEMO_ADDRESS=123 Maple Ave, Austin, TX 78701
DEMO_PHONE=+1-512-555-0142
DEMO_DOB=1990-04-12
DEMO_EMAIL=alex.rivera.optout@example.com
